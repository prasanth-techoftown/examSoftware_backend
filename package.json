{
    "name": "vilora-tech-exam-backend",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "start": "node dist/index.js",
        "build": "tsc",
        "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/config/data-source.ts",
"migration:show": "TS_NODE_TRANSPILE_ONLY=true typeorm-ts-node-commonjs migration:show -d src/config/data-source.ts",
"migration:run": "TS_NODE_TRANSPILE_ONLY=true typeorm-ts-node-commonjs migration:run -d src/config/data-source.ts",
"migration:revert": "TS_NODE_TRANSPILE_ONLY=true typeorm-ts-node-commonjs migration:revert -d src/config/data-source.ts",
        "prepush": "pnpm format && pnpm lint && pnpm typecheck && pnpm run build"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.18.2",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.3.3",
        "@types/nodemailer": "^7.0.11",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@types/multer": "^2.1.0",
        "@typescript-eslint/eslint-plugin": "^8.57.0",
        "@typescript-eslint/parser": "^8.57.0",
        "axios": "^1.13.6",
        "bcrypt": "^6.0.0",
        "compression": "^1.8.1",
        "connect-redis": "^9.0.0",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "eslint": "^10.0.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-unused-imports": "^4.4.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.2.1",
        "express-session": "^1.19.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.1.1",
        "mysql2": "^3.18.2",
        "nodemailer": "^8.0.2",
        "nodemon": "^3.1.14",
        "prettier": "^3.8.1",
        "prom-client": "^15.1.3",
        "rate-limit-redis": "^4.3.1",
        "redis": "^5.11.0",
        "reflect-metadata": "^0.2.2",
        "snowflake-id": "^1.1.0",
        "socket.io": "^4.8.3",
        "tsyringe": "^4.10.0",
        "typeorm": "^0.3.28",
        "ua-parser-js": "^2.0.9"
    }
}
